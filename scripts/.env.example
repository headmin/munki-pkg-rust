# Signing identities (from Keychain)
SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"
INSTALLER_IDENTITY="Developer ID Installer: Your Name (TEAM_ID)"

# Notarization profile (from notarytool store-credentials)
NOTARIZE_PROFILE=""

# 1Password references for notarization
OP_APPLE_ID="op://credentials/NOTARIZATION_APPLE_ID/credential"
OP_PASSWORD="op://credentials/NOTARIZATION_PASSWORD/credential"
OP_TEAM_ID="op://credentials/NOTARIZATION_TEAM_ID/credential"

# Set to true to use 1Password CLI for notarization credentials
USE_1PASSWORD=false
